+/// perp implementation of ServiceManager.
+#[cfg(feature = "perp")]
+pub struct PerpServiceManager {
+    service_name: String,
+}
+
+#[cfg(feature = "perp")]
+impl PerpServiceManager {
+    pub fn new(service_name: impl Into<String>) -> Self {
+        Self {
+            service_name: service_name.into(),
+        }
+    }
+
+    fn service_dir(&self) -> std::path::PathBuf {
+        std::path::Path::new("/etc/perp").join(&self.service_name)
+    }
+}
+
+#[cfg(feature = "perp")]
+impl ServiceManager for PerpServiceManager {
+    fn is_enabled(&self) -> bool {
+        use std::os::unix::fs::PermissionsExt;
+        self.service_dir()
+            .metadata()
+            .map(|metadata| metadata.permissions().mode() & 0o1000 != 0)
+            .unwrap_or(false)
+    }
+
+    fn is_active(&self) -> bool {
+        std::process::Command::new("perpok")
+            .args(["-b", "/etc/perp", &self.service_name])
+            .status()
+            .map(|status| status.success())
+            .unwrap_or(false)
+    }
+
+    fn activate(&self) -> Pin<Box<dyn Future<Output = ()> + Send>> {
+        let service = self.service_name.clone();
+        Box::pin(async move {
+            run_pkexec_command(
+                &["perpctl", "-b", "/etc/perp", "A", &service],
+                "perpctl activate",
+                &service,
+            )
+            .await;
+        })
+    }
+
+    fn enable(&self) -> Pin<Box<dyn Future<Output = ()> + Send>> {
+        // Activating a perp service also sets its sticky bit, the marker
+        // perpd uses for services that should be started on boot.
+        self.activate()
+    }
+
+    fn is_installed(&self) -> bool {
+        self.service_dir().join("rc.main").exists()
+    }
+}
