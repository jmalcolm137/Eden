#!/bin/sh
# Session startup for uid 1000, run by the perp "session" service.
# Starts the session bus and xfconfd, then hands over to the compositor.

export HOME=/home/action
export USER=action
export LOGNAME=action
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export XDG_RUNTIME_DIR=/run/user/1000
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_DESKTOP=xfce
export XKB_CONFIG_ROOT=/usr/share/X11/xkb
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24
# render the pointer in software so VM framebuffers show it
export WLR_NO_HARDWARE_CURSORS=1
unset DISPLAY
unset WAYLAND_DISPLAY

mkdir -p "$XDG_RUNTIME_DIR"
rm -f "$XDG_RUNTIME_DIR/bus"

/usr/bin/dbus-daemon --session --nofork \
    --address="unix:path=$XDG_RUNTIME_DIR/bus" --nopidfile &

i=0
while [ ! -S "$XDG_RUNTIME_DIR/bus" ] && [ "$i" -lt 10 ]; do
    sleep 1
    i=$((i + 1))
done

export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

# minimal Xfconf daemon on the session bus
/usr/lib/xfce4/xfconf/xfconfd &
sleep 1

# keep the kernel console free of desktop debug output
exec >>"$XDG_RUNTIME_DIR/eden-session.log" 2>&1

exec /usr/bin/xfwl4 --backend tty --session /usr/local/bin/eden-session
