#!/bin/sh
# cbuild runs `linux64 -- <command>` inside the build root. On a native
# 64-bit Oasis system the default personality is already correct, so this
# shim just skips the separator and options and execs the command.
while [ "$#" -gt 0 ]; do
    case "$1" in
        --)
            shift
            break
            ;;
        -*)
            shift
            ;;
        *)
            break
            ;;
    esac
done
exec "$@"
