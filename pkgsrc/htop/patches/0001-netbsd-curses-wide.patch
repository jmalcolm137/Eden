+#if defined(NCURSES_VERSION)
+#define CCHAR_CHAR(c) ((c).chars[0])
+#define CCHAR_ATTR(c) ((c).attr)
+#define CCHAR_SETATTR(c, a) ((c).attr = (a))
+#define CCHAR_MAKE(ch, a) ((cchar_t) { .attr = (a), .chars = { (ch), 0 } })
+#else
+/* NetBSD curses stores wide characters in attributes/elements/vals[] */
+#include <string.h>
+static inline cchar_t CCHAR_MAKE(wchar_t ch, attr_t a) {
+   cchar_t cc;
+   memset(&cc, 0, sizeof(cc));
+   cc.attributes = a;
+   cc.elements = 1;
+   cc.vals[0] = ch;
+   return cc;
+}
+#define CCHAR_CHAR(c) ((c).vals[0])
+#define CCHAR_ATTR(c) ((c).attributes)
+#define CCHAR_SETATTR(c, a) ((c).attributes = (a))
+#endif
